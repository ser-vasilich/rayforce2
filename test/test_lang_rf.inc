    ASSERT_EQ("(concat [10:00:00.000] 10:00:00.001)", "[10:00:00.000 10:00:00.001]");
    ASSERT_EQ("(concat 10:00:00.000 [10:00:00.001])", "[10:00:00.000 10:00:00.001]");
    ASSERT_EQ("(concat [10:00:00.000] [10:00:00.001])", "[10:00:00.000 10:00:00.001]");
