        "t",
        "(table [ID Name Value] (list [1 2 3] [alice bobby charlie] [10.0 25.0 30.0]))");

    // Test 16: Upsert via dict (immediate, new record)
    ASSERT_EQ(
        "(set t (table [ID Name Value] (list [1 2] [alice bob] [10.0 20.0])))"
