    // Test 14: Upsert multiple records with mixed insert/update (immediate)
    ASSERT_EQ(
        "(set t (table [ID Name Value] (list [1 2] [alice bob] [10.0 20.0])))"
        "(upsert t 1 (list [2 3] [bobby charlie] [25.0 30.0]))",
