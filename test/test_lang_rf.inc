    ASSERT_EQ("(concat \"te\" \"st\")", "\"test\"");
    ASSERT_EQ("(concat 't' \"est\\000\")", "\"test\"");
    ASSERT_EQ("(concat \"tes\\000\" 't')", "\"test\"");
    ASSERT_EQ("(concat \"te\\000\" \"st\\000\")", "\"test\"");
