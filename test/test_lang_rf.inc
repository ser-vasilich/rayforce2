static MunitResult test_rf_timestamp(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // Test ISO date-only format
    ASSERT_EQ("(as 'timestamp \"2004-10-21\")", "2004.10.21D00:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2024-03-20\")", "2024.03.20D00:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2023-12-31\")", "2023.12.31D00:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2025-01-01\")", "2025.01.01D00:00:00.000000000");

    // Test ISO date-time with space separator
    ASSERT_EQ("(as 'timestamp \"2004-10-21 12:00:00\")", "2004.10.21D12:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2025-03-04 15:41:47\")", "2025.03.04D15:41:47.000000000");
    ASSERT_EQ("(as 'timestamp \"2023-06-15 09:30:45\")", "2023.06.15D09:30:45.000000000");

    // Test ISO date-time with T separator
    ASSERT_EQ("(as 'timestamp \"2004-10-21T12:00:00\")", "2004.10.21D12:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2025-03-04T15:41:47\")", "2025.03.04D15:41:47.000000000");

    // Test ISO with fractional seconds (milliseconds)
    ASSERT_EQ("(as 'timestamp \"2004-10-21 12:00:00.010\")", "2004.10.21D12:00:00.010000000");
    ASSERT_EQ("(as 'timestamp \"2025-03-04 15:41:47.123\")", "2025.03.04D15:41:47.123000000");

    // Test ISO with fractional seconds (microseconds)
    ASSERT_EQ("(as 'timestamp \"2004-10-21 12:00:00.010500\")", "2004.10.21D12:00:00.010500000");
    ASSERT_EQ("(as 'timestamp \"2025-03-04 15:41:47.123456\")", "2025.03.04D15:41:47.123456000");

    // Test ISO with fractional seconds (nanoseconds)
    ASSERT_EQ("(as 'timestamp \"2004-10-21 12:00:00.010000000\")", "2004.10.21D12:00:00.010000000");
    ASSERT_EQ("(as 'timestamp \"2025-03-04T15:41:47.087221025\")", "2025.03.04D15:41:47.087221025");

    // Test ISO with UTC timezone (Z)
    ASSERT_EQ("(as 'timestamp \"2004-10-21T12:00:00Z\")", "2004.10.21D12:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2025-03-04T15:41:47.123456789Z\")", "2025.03.04D15:41:47.123456789");

    // Test ISO with positive timezone offset
    // 2004-10-21 12:00:00+02:00 should convert to 10:00:00 UTC
    ASSERT_EQ("(as 'timestamp \"2004-10-21 12:00:00+02:00\")", "2004.10.21D10:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2004-10-21T12:00:00+02:00\")", "2004.10.21D10:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2025-03-04 15:41:47+05:30\")", "2025.03.04D10:11:47.000000000");
    ASSERT_EQ("(as 'timestamp \"2023-06-15 18:30:00+01:00\")", "2023.06.15D17:30:00.000000000");

    // Test ISO with negative timezone offset
    // 2004-10-21 12:00:00-05:00 should convert to 17:00:00 UTC
    ASSERT_EQ("(as 'timestamp \"2004-10-21 12:00:00-05:00\")", "2004.10.21D17:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2004-10-21 12:00:00.010-23:00\")", "2004.10.22D11:00:00.010000000");
    ASSERT_EQ("(as 'timestamp \"2025-03-04T08:00:00-08:00\")", "2025.03.04D16:00:00.000000000");

    // Test ISO with timezone without colon separator
    ASSERT_EQ("(as 'timestamp \"2004-10-21 12:00:00+0200\")", "2004.10.21D10:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2004-10-21 12:00:00-0500\")", "2004.10.21D17:00:00.000000000");

    // Test ISO with fractional seconds and timezone
    ASSERT_EQ("(as 'timestamp \"2004-10-21 12:00:00.123456+02:00\")", "2004.10.21D10:00:00.123456000");
    ASSERT_EQ("(as 'timestamp \"2025-03-04T15:41:47.087-05:00\")", "2025.03.04D20:41:47.087000000");

    // Test that rayforce format still works
    ASSERT_EQ("(as 'timestamp \"2004.10.21D12:00:00.000000000\")", "2004.10.21D12:00:00.000000000");
    ASSERT_EQ("(as 'timestamp \"2025.03.04D15:41:47.087221025\")", "2025.03.04D15:41:47.087221025");
    return MUNIT_OK;
}

static MunitResult test_rf_aggregations(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== SUM TESTS ==========
    ASSERT_EQ("(sum [1 2 3 4 5])", "15");
    ASSERT_EQ("(sum [1.0 2.0 3.0])", "6.0");
    ASSERT_EQ("(sum [1i 2i 3i])", "6i");
    ASSERT_EQ("(sum [])", "0");
    ASSERT_EQ("(sum 5)", "5");  // scalar

    // ========== AVG TESTS ==========
    ASSERT_EQ("(avg [1 2 3 4 5])", "3.0");
    ASSERT_EQ("(avg [10.0 20.0 30.0])", "20.0");
    ASSERT_EQ("(avg [2 4 6 8])", "5.0");
    ASSERT_EQ("(avg 10)", "10.0");  // scalar

    // ========== MIN TESTS ==========
    ASSERT_EQ("(min [5 2 8 1 9])", "1");
    ASSERT_EQ("(min [5.0 2.0 8.0])", "2.0");
    ASSERT_EQ("(min [-5 -2 -8])", "-8");
    ASSERT_EQ("(min [5i 2i 8i])", "2i");
    ASSERT_EQ("(min 42)", "42");  // scalar

    // ========== MAX TESTS ==========
    ASSERT_EQ("(max [5 2 8 1 9])", "9");
    ASSERT_EQ("(max [5.0 2.0 8.0])", "8.0");
    ASSERT_EQ("(max [-5 -2 -8])", "-2");
    ASSERT_EQ("(max [5i 2i 8i])", "8i");
    ASSERT_EQ("(max 42)", "42");  // scalar

    // ========== COUNT TESTS ==========
    ASSERT_EQ("(count [1 2 3 4 5])", "5");
    ASSERT_EQ("(count [])", "0");
    ASSERT_EQ("(count \"hello\")", "5");
    ASSERT_EQ("(count (dict [a b c] [1 2 3]))", "3");
    ASSERT_EQ("(count (table [a b] (list [1 2 3] [4 5 6])))", "3");
    ASSERT_EQ("(count 5)", "1");  // scalar

    // ========== FIRST TESTS ==========
    ASSERT_EQ("(first [1 2 3 4 5])", "1");
    ASSERT_EQ("(first \"hello\")", "'h'");
    ASSERT_EQ("(first ['a 'b 'c])", "'a");
    ASSERT_EQ("(first (table [a b] (list [1 2 3] [4 5 6])))", "{a:1 b:4}");

    // ========== LAST TESTS ==========
    ASSERT_EQ("(last [1 2 3 4 5])", "5");
    ASSERT_EQ("(last \"hello\")", "'o'");
    ASSERT_EQ("(last ['a 'b 'c])", "'c");
    ASSERT_EQ("(last (table [a b] (list [1 2 3] [4 5 6])))", "{a:3 b:6}");

    // ========== MED (MEDIAN) TESTS ==========
    ASSERT_EQ("(med [1 2 3 4 5])", "3.0");
    ASSERT_EQ("(med [1 2 3 4])", "2.5");
    ASSERT_EQ("(med [5 1 3 2 4])", "3.0");  // unsorted input

    // ========== DEV (STANDARD DEVIATION) TESTS ==========
    ASSERT_EQ("(dev [1 1 1 1])", "0.0");
    ASSERT_EQ("(< (- (dev [1 2 3 4 5]) 1.4142) 0.001)", "true");  // approx sqrt(2);

    // ========== AGGREGATIONS ON TABLES WITH GROUPBY ==========
    ASSERT_EQ(
        "(set t (table [Group Value] (list [a a b b] [10 20 30 40])))"
        "(select {from: t Total: (sum Value) by: Group})",
        "(table [Group Total] (list [a b] [30 70]))");

    ASSERT_EQ(
        "(set t (table [Group Value] (list [a a b b] [10 20 30 40])))"
        "(select {from: t Avg: (avg Value) by: Group})",
        "(table [Group Avg] (list [a b] [15.0 35.0]))");

    ASSERT_EQ(
        "(set t (table [Group Value] (list [a a b b] [10 20 30 40])))"
        "(select {from: t Min: (min Value) Max: (max Value) by: Group})",
        "(table [Group Min Max] (list [a b] [10 30] [20 40]))");

    ASSERT_EQ(
        "(set t (table [Group Value] (list [a a a b b] [1 2 3 4 5])))"
        "(select {from: t Cnt: (count Value) by: Group})",
        "(table [Group Cnt] (list [a b] [3 2]))");
    return MUNIT_OK;
}

static MunitResult test_rf_joins(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // asof-join basic
    ASSERT_EQ(
        "(set trades (table [Sym Time Price] (list [x x] [10:00:01.000 10:00:03.000] [100.0 101.0])))"
        "(set quotes (table [Sym Time Bid] (list [x x x] [10:00:00.000 10:00:02.000 10:00:04.000] [99.0 100.5 101.5])))"
        "(asof-join [Sym Time] trades quotes)",
        "(table [Sym Time Price Bid] (list [x x] [10:00:01.000 10:00:03.000] [100.0 101.0] [99.0 100.5]))");

    // asof-join single matching symbol
    ASSERT_EQ(
        "(set trades (table [Sym Time Price] (list [a] [10:00:05.000] [50.0])))"
        "(set quotes (table [Sym Time Bid] (list [a a] [10:00:01.000 10:00:03.000] [48.0 49.0])))"
        "(asof-join [Sym Time] trades quotes)",
        "(table [Sym Time Price Bid] (list [a] [10:00:05.000] [50.0] [49.0]))");

    // asof-join with exact match on boundary
    ASSERT_EQ(
        "(set trades (table [Sym Time Price] (list [a] [10:00:01.000] [50.0])))"
        "(set quotes (table [Sym Time Bid] (list [a a] [10:00:01.000 10:00:03.000] [48.0 49.0])))"
        "(asof-join [Sym Time] trades quotes)",
        "(table [Sym Time Price Bid] (list [a] [10:00:01.000] [50.0] [48.0]))");

    // asof-join with I64 + Timestamp
    ASSERT_EQ(
        "(set aj1 (table [ID Ts Val] (list [1 1 2 2] "
        "[2024.01.01D10:00:01.000000000 2024.01.01D10:00:05.000000000 2024.01.01D10:00:03.000000000 "
        "2024.01.01D10:00:07.000000000] "
        "[100 200 300 400])))"
        "(set aj2 (table [ID Ts Ref] (list [1 1 2 2] "
        "[2024.01.01D10:00:00.000000000 2024.01.01D10:00:04.000000000 2024.01.01D10:00:02.000000000 "
        "2024.01.01D10:00:06.000000000] "
        "[10 20 30 40])))"
        "(at (asof-join [ID Ts] aj1 aj2) 'Ref)",
        "[10 20 30 40]");

    // asof-join with Symbol + Date
    ASSERT_EQ(
        "(set orders (table [Cust Date Amount] (list [A A B B] [2024.01.02 2024.01.05 2024.01.03 2024.01.06] [100 200 "
        "300 400])))"
        "(set rates (table [Cust Date Rate] (list [A A B B] [2024.01.01 2024.01.04 2024.01.01 2024.01.05] [0.1 0.15 "
        "0.2 0.25])))"
        "(at (asof-join [Cust Date] orders rates) 'Rate)",
        "[0.1 0.15 0.2 0.25]");

    // left-join all rows match
    ASSERT_EQ(
        "(set t1 (table [ID Name] (list [1 3] [a c])))"
        "(set t2 (table [ID Value] (list [1 3] [100 300])))"
        "(left-join [ID] t1 t2)",
        "(table [ID Name Value] (list [1 3] [a c] [100 300]))");

    // left-join partial matches
    ASSERT_EQ(
        "(set t1 (table [ID Name] (list [1 2 3] [a b c])))"
        "(set t2 (table [ID Value] (list [1 3] [100 300])))"
        "(count (left-join [ID] t1 t2))",
        "3");

    // left-join by Date
    ASSERT_EQ(
        "(set t1 (table [dt val1] (list [2024.01.01 2024.01.02 2024.01.03] [100 200 300])))"
        "(set t2 (table [dt val2] (list [2024.01.01 2024.01.03] [1000 3000])))"
        "(count (left-join [dt] t1 t2))",
        "3");

    // left-join by Time
    ASSERT_EQ(
        "(set t1 (table [tm val1] (list [10:00:00 10:00:01 10:00:02] [100 200 300])))"
        "(set t2 (table [tm val2] (list [10:00:00 10:00:02] [1000 3000])))"
        "(count (left-join [tm] t1 t2))",
        "3");

    // inner-join basic
    ASSERT_EQ(
        "(set t1 (table [id val1] (list [1 2 3 4 5] [100 200 300 400 500])))"
        "(set t2 (table [id val2] (list [1 3 5 6 7] [1000 3000 5000 6000 7000])))"
        "(count (inner-join [id] t1 t2))",
        "3");

    // inner-join returns correct right values
    ASSERT_EQ(
        "(set t1 (table [id val1] (list [1 2 3 4 5] [100 200 300 400 500])))"
        "(set t2 (table [id val2] (list [1 3 5 6 7] [1000 3000 5000 6000 7000])))"
        "(at (inner-join [id] t1 t2) 'val2)",
        "[1000 3000 5000]");

    // inner-join preserves correct left values
    ASSERT_EQ(
        "(set t1 (table [id val1] (list [1 2 3 4 5] [100 200 300 400 500])))"
        "(set t2 (table [id val2] (list [1 3 5 6 7] [1000 3000 5000 6000 7000])))"
        "(at (inner-join [id] t1 t2) 'val1)",
        "[100 300 500]");

    // inner-join by Date
    ASSERT_EQ(
        "(set t1 (table [dt val1] (list [2024.01.01 2024.01.02 2024.01.03] [100 200 300])))"
        "(set t2 (table [dt val2] (list [2024.01.01 2024.01.03 2024.01.05] [1000 3000 5000])))"
        "(count (inner-join [dt] t1 t2))",
        "2");

    // inner-join by Time
    ASSERT_EQ(
        "(set t1 (table [tm val1] (list [10:00:00 10:00:01 10:00:02] [100 200 300])))"
        "(set t2 (table [tm val2] (list [10:00:00 10:00:02 10:00:05] [1000 3000 5000])))"
        "(count (inner-join [tm] t1 t2))",
        "2");

    // inner-join with no matches
    ASSERT_EQ(
        "(set t1 (table [id val1] (list [1 2 3] [100 200 300])))"
        "(set t2 (table [id val2] (list [4 5 6] [400 500 600])))"
        "(count (inner-join [id] t1 t2))",
        "0");

    // inner-join with all matches
    ASSERT_EQ(
        "(set t1 (table [id val1] (list [1 2 3] [100 200 300])))"
        "(set t2 (table [id val2] (list [1 2 3] [1000 2000 3000])))"
        "(count (inner-join [id] t1 t2))",
        "3");

    // inner-join by Symbol
    ASSERT_EQ(
        "(set t1 (table [sym val1] (list [AAPL GOOG MSFT] [100 200 300])))"
        "(set t2 (table [sym val2] (list [AAPL MSFT TSLA] [1000 3000 5000])))"
        "(count (inner-join [sym] t1 t2))",
        "2");

    // inner-join by F64
    ASSERT_EQ(
        "(set t1 (table [price val1] (list [1.0 2.0 3.0] [100 200 300])))"
        "(set t2 (table [price val2] (list [1.0 3.0 5.0] [1000 3000 5000])))"
        "(count (inner-join [price] t1 t2))",
        "2");

    // inner-join multi-key
    ASSERT_EQ(
        "(set t1 (table [id1 id2 val1] (list [1 1 2] [a b a] [100 200 300])))"
        "(set t2 (table [id1 id2 val2] (list [1 2] [a a] [1000 3000])))"
        "(count (inner-join [id1 id2] t1 t2))",
        "2");

    // window-join
    ASSERT_EQ(
        "(set trades (table [Sym Time Price] (list [a a] [10:00:01.000 10:00:05.000] [100 200])))"
        "(set quotes (table [Sym Time Bid] (list [a a a] [10:00:00.000 10:00:02.000 10:00:04.000] [99 100 101])))"
        "(set intervals (map-left + [-2000 2000] (at trades 'Time)))"
        "(at (window-join [Sym Time] intervals trades quotes {minBid: (min Bid)}) 'minBid)",
        "[99 101]");

    // window-join1
    ASSERT_EQ(
        "(set trades (table [Sym Time Price] (list [a a] [10:00:01.000 10:00:05.000] [100 200])))"
        "(set quotes (table [Sym Time Bid] (list [a a a] [10:00:00.000 10:00:02.000 10:00:04.000] [99 100 101])))"
        "(set intervals (map-left + [-2000 2000] (at trades 'Time)))"
        "(at (window-join1 [Sym Time] intervals trades quotes {minBid: (min Bid)}) 'minBid)",
        "[99 101]");

    // window-join with raw column (TYPE_MAPGROUP)
    ASSERT_EQ(
        "(set trades (table [Sym Time Price] (list [a a] [10:00:01.000 10:00:05.000] [100 200])))"
        "(set quotes (table [Sym Time Bid] (list [a a a] [10:00:00.000 10:00:02.000 10:00:04.000] [99 100 101])))"
        "(set intervals (map-left + [-2000 2000] (at trades 'Time)))"
        "(count (at (window-join [Sym Time] intervals trades quotes {bids: Bid}) 'bids))",
        "2");

    // window-join1 with raw column (TYPE_MAPGROUP)
    ASSERT_EQ(
        "(set trades (table [Sym Time Price] (list [a a] [10:00:01.000 10:00:05.000] [100 200])))"
        "(set quotes (table [Sym Time Bid] (list [a a a] [10:00:00.000 10:00:02.000 10:00:04.000] [99 100 101])))"
        "(set intervals (map-left + [-2000 2000] (at trades 'Time)))"
        "(count (at (window-join1 [Sym Time] intervals trades quotes {bids: Bid}) 'bids))",
        "2");

    // window-join with Enum columns (xasc converts Enum to Symbol)
    ASSERT_EQ(
        "(set trades (table [s time price] (list ['a 'a 'b] [10:00:01.000 10:00:05.000 10:00:03.000] [100 "
        "200 150])))"
        "(set quotes (table [s time bid] (list ['a 'a 'a 'b 'b] [10:00:00.000 10:00:02.000 10:00:04.000 "
        "10:00:01.000 10:00:04.000] [99 100 101 149 151])))"
        "(set intervals (map-left + [-2000 2000] (at trades 'time)))"
        "(at (window-join [s time] intervals trades quotes {minBid: (min bid)}) 'minBid)",
        "[99 101 149]");

    // empty left table
    ASSERT_EQ(
        "(set t1 (table [id val1] (list (take [1] 0) (take [1] 0))))"
        "(set t2 (table [id val2] (list [1 2 3] [100 200 300])))"
        "(count (left-join [id] t1 t2))",
        "0");

    // empty right table
    ASSERT_EQ(
        "(set t1 (table [id val1] (list [1 2 3] [100 200 300])))"
        "(set t2 (table [id val2] (list (take [1] 0) (take [1] 0))))"
        "(count (left-join [id] t1 t2))",
        "3");

    // empty tables for inner-join
    ASSERT_EQ(
        "(set t1 (table [id val1] (list (take [1] 0) (take [1] 0))))"
        "(set t2 (table [id val2] (list [1 2 3] [100 200 300])))"
        "(count (inner-join [id] t1 t2))",
        "0");

    // left-join multi-key
    ASSERT_EQ(
        "(set t1 (table [id1 id2 val1] (list [1 1 2] [a b a] [100 200 300])))"
        "(set t2 (table [id1 id2 val2] (list [1 2] [a a] [1000 3000])))"
        "(count (left-join [id1 id2] t1 t2))",
        "3");

    // inner-join with Timestamp
    ASSERT_EQ(
        "(set t1 (table [ts val1] (list [2024.01.01D10:00:00.000000000 2024.01.01D10:00:01.000000000 "
        "2024.01.01D10:00:02.000000000] [100 200 300])))"
        "(set t2 (table [ts val2] (list [2024.01.01D10:00:00.000000000 2024.01.01D10:00:02.000000000] [1000 3000])))"
        "(count (inner-join [ts] t1 t2))",
        "2");

    // asof-join no match before returns Null
    ASSERT_EQ(
        "(set trades (table [Sym Time Price] (list [a] [10:00:00.000] [100.0])))"
        "(set quotes (table [Sym Time Bid] (list [a] [10:00:05.000] [99.0])))"
        "(count (asof-join [Sym Time] trades quotes))",
        "1");

    // error: left-join wrong type
    ASSERT_ER("(left-join 123 (table [a] (list [1])) (table [a] (list [1])))", "type");

    // error: inner-join wrong type
    ASSERT_ER("(inner-join [a] [1 2 3] (table [a] (list [1])))", "type");

    // error: asof-join wrong arity
    ASSERT_ER("(asof-join [a b])", "arity");
    return MUNIT_OK;
}

static MunitResult test_rf_temporal(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== DATE ARITHMETIC ==========
    ASSERT_EQ("(+ 2024.01.01 1)", "2024.01.02");
    ASSERT_EQ("(+ 2024.01.01 30)", "2024.01.31");
    ASSERT_EQ("(+ 2024.01.01 31)", "2024.02.01");
    ASSERT_EQ("(- 2024.01.10 5)", "2024.01.05");
    ASSERT_EQ("(- 2024.02.01 2024.01.01)", "31");

    // ========== TIME ARITHMETIC ==========
    ASSERT_EQ("(+ 10:00:00.000 1000)", "10:00:01.000");
    ASSERT_EQ("(+ 10:00:00.000 60000)", "10:01:00.000");
    ASSERT_EQ("(+ 10:00:00.000 3600000)", "11:00:00.000");
    ASSERT_EQ("(- 10:00:01.000 1000)", "10:00:00.000");
    ASSERT_EQ("(- 10:00:01.000 10:00:00.000)", "00:00:01.000");

    // ========== TIMESTAMP ARITHMETIC ==========
    ASSERT_EQ("(+ 2024.01.01D10:00:00.000000000 1000000000)", "2024.01.01D10:00:01.000000000");
    ASSERT_EQ("(- 2024.01.01D10:00:01.000000000 1000000000)", "2024.01.01D10:00:00.000000000");

    // ========== VECTOR OPERATIONS ==========
    ASSERT_EQ("(+ [2024.01.01 2024.01.02] 1)", "[2024.01.02 2024.01.03]");
    ASSERT_EQ("(- [2024.01.10 2024.01.20] [2024.01.01 2024.01.10])", "[9 10]");
    return MUNIT_OK;
}

