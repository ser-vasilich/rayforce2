static MunitResult test_rf_in(const void* params, void* fixture) {
    (void)params; (void)fixture;

    ASSERT_EQ("(in 2 2)", "true");
    ASSERT_EQ("(in false [true false])", "true");
    ASSERT_EQ("(in 0x12 [0x12 0x11 0x10])", "true");
    ASSERT_EQ("(in 'e' \"test\")", "[true]");
    ASSERT_EQ("(in \"asd\" \"asd\")", "[true true true]");
    ASSERT_EQ("(in \"asd\" 'a')", "[true false false]");
    ASSERT_EQ("(in 1h [2h 3h])", "false");
    ASSERT_EQ("(in 2h [2 3])", "true");
    ASSERT_EQ("(in 1i [1i 0Ni 2i])", "true");
    ASSERT_EQ("(in 2012.12.12 [2012.12.12 2012.12.13])", "true");
    ASSERT_EQ("(in 10:00:00.000 [10:00:00.000 20:10:10.500])", "true");
    ASSERT_EQ("(in 1 [0Nl])", "false");
    ASSERT_EQ("(in 'a ['a 'b 'c 'dd])", "true");
    ASSERT_EQ("(in 2024.01.01D10:00:00.000000000 [])", "false");
    ASSERT_EQ("(in 1.0 [1.0 2.0 3.0])", "true");
    ASSERT_EQ("(in (guid 2) [])", "[false false]");
    ASSERT_EQ("(in 2 (list '3' 2))", "true");
    ASSERT_EQ("(in 3 [1i 0Ni 2i])", "false");
    ASSERT_EQ("(in [true false] [false])", "[false true]");
    ASSERT_EQ("(in [0x00 0x01] [0x02 0x00])", "[true false]");
    ASSERT_EQ("(in \"test\" \"post\")", "[true false true true]");
    ASSERT_EQ("(in [3h 2h 5h 0Nh] [1h 0Nh 2h 3h])", "[true true false true]");
    ASSERT_EQ("(in [3 2 5 0Nl -32768] [1h 0Nh 2h 3h])", "[true true false true false]");
    ASSERT_EQ("(in [3i 2i 5i 0Ni -32768i] [1h 0Nh 2h 3h])", "[true true false true false]");
    ASSERT_EQ("(in [3i 2i 5i 0Ni] [1i 0Ni 2i 3i])", "[true true false true]");
    ASSERT_EQ("(in [3h 2h 5h 0Nh] [1i 0Ni 2i 3i])", "[true true false true]");
    ASSERT_EQ("(in [3h 2h 5h 0Nh] [1 0Nl 2 3])", "[true true false true]");
    ASSERT_EQ("(in [3 2 5 0Nl -2147483648] [1i 0Ni 2i 3i])", "[true true false true false]");
    ASSERT_EQ("(in [3i 2i 0Ni] [1 0Nl 2 3])", "[true true true]");
    ASSERT_EQ("(in [3 2 5 0Nl] [1 0Nl 2 3])", "[true true false true]");
    ASSERT_EQ("(in (list 3h 2i 5 0Nl) [1 0Nl 2 3])", "(list true true false true)");
    ASSERT_EQ("(in [0 1 0Nl] 0Nl)", "[false false true]");
    ASSERT_EQ("(in [3] (list 3i 2 5))", "[true]");
    ASSERT_EQ("(in 'a' (list \"iu\" \"asd\"))", "[false]");
    ASSERT_EQ("(in 'a' (list \"iu\" \"asd\" 'a'))", "[true]");
    ASSERT_EQ("(in \"asd\" (list \"iu\" \"asd\"))", "[false false false]");
    ASSERT_EQ("(in \"asd\" (list 'd' \"asd\"))", "[false false true]");
    ASSERT_EQ("(in (list \"asd\") (list \"iu\" \"asd\"))", "(list [false false false])");      //(list true);
    ASSERT_EQ("(in (list \"asd\" \"iu\") \"asd\")", "(list [true true true] [false false])");  //(list false false);
    ASSERT_EQ("(set l (guid 2)) (in l l)", "[true true]");
    ASSERT_EQ("(set l (guid 2)) (in (first l) l)", "true");
    ASSERT_EQ("(set l (guid 2)) (in l (first l))", "[true false]");
    ASSERT_EQ("(set l (guid 2)) (in (first l) (list (first l)))", "true");
    ASSERT_EQ("(set l (guid 2)) (in (list (first l)) l)", "(list true)");
    ASSERT_EQ("(set l (guid 2)) (in (list (first l)) (list l))", "(list false)");
    ASSERT_EQ("(set l (guid 2)) (in (list (first l)) (list (first l)))", "(list true)");

    // ========== I16 x I8 "IN" TESTS (Bug fix: index_in_i16_i8) ==========
    // Test i16 values against i8 lookup set
    ASSERT_EQ("(in [1h 2h 3h] [1 2])", "[true true false]");             // i16 in i8 range
    ASSERT_EQ("(in [100h 50h 25h] [50 100])", "[true true false]");      // i16 values in i8 lookup
    ASSERT_EQ("(in [-128h 127h 0h] [-128 0 127])", "[true true true]");  // i8 boundary values
    ASSERT_EQ("(in [200h 10h] [10])", "[false true]");                   // value outside i8 range

    // ========== I16 x I16 "IN" TESTS (Bug fix: index_in_i16_i16 wrong size) ==========
    // Test when x length > y length (was causing buffer overflow)
    ASSERT_EQ("(in [1h 2h 3h 4h 5h] [2h 4h])", "[false true false true false]");
    ASSERT_EQ("(in [10h 20h 30h 40h 50h 60h] [20h])", "[false true false false false false]");
    // Test when x length < y length
    ASSERT_EQ("(in [1h 2h] [1h 2h 3h 4h 5h])", "[true true]");
    // Test with equal lengths
    ASSERT_EQ("(in [1h 2h 3h] [3h 2h 1h])", "[true true true]");
    // Test with empty arrays
    ASSERT_EQ("(in (list) [1h 2h])", "(list)");
    return MUNIT_OK;
}

static MunitResult test_rf_except(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // Basic symbol except
    ASSERT_EQ("(except ['a 'b 'c] ['u 'o])", "[a b c]");
    ASSERT_EQ("(except ['a 'b 'c] ['a 'c])", "[b]");
    ASSERT_EQ("(except ['a 'b 'c] ['b])", "[a c]");
    ASSERT_EQ("(except ['a 'b 'c] ['a 'b 'c])", "[]");

    // Integer except
    ASSERT_EQ("(except [1 2 3 4 5] [2 4])", "[1 3 5]");
    ASSERT_EQ("(except [1 2 3] [5 6 7])", "[1 2 3]");
    ASSERT_EQ("(except [10 20 30] [10 30])", "[20]");
    ASSERT_EQ("(except [1 2 3] [1 2 3])", "[]");

    // Empty cases
    ASSERT_EQ("(except [] [1 2 3])", "[]");
    ASSERT_EQ("(except [1 2 3] [])", "[1 2 3]");
    ASSERT_EQ("(except [] [])", "[]");

    // Single element except
    ASSERT_EQ("(except ['x] ['x])", "[]");
    ASSERT_EQ("(except ['x] ['y])", "[x]");
    ASSERT_EQ("(except [42] [42])", "[]");
    ASSERT_EQ("(except [42] [99])", "[42]");

    // Scalar except vector
    ASSERT_EQ("(except [1 2 3 4 5] 3)", "[1 2 4 5]");
    ASSERT_EQ("(except ['a 'b 'c] 'b)", "[a c]");
    ASSERT_EQ("(except [1 2 3] 9)", "[1 2 3]");

    // Duplicates handling
    ASSERT_EQ("(except [1 1 2 2 3] [1 3])", "[2 2]");
    ASSERT_EQ("(except ['a 'a 'b 'c 'c] ['a 'c])", "[b]");
    return MUNIT_OK;
}

