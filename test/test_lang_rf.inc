static MunitResult test_rf_literals(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // Test basic character literals
    ASSERT_EQ("'a'", "'a'");
    ASSERT_EQ("'z'", "'z'");
    ASSERT_EQ("'0'", "'0'");
    ASSERT_EQ("'9'", "'9'");

    // Test standard escape sequences in character literals
    ASSERT_EQ("'\\n'", "'\\n'");
    ASSERT_EQ("'\\r'", "'\\r'");
    ASSERT_EQ("'\\t'", "'\\t'");
    ASSERT_EQ("'\\\\'", "'\\\\'");
    ASSERT_EQ("'\\''", "'\\''");

    // Test octal escape sequences in character literals
    ASSERT_EQ("'\\001'", "'\\001'");  // SOH (Start of Heading);
    ASSERT_EQ("'\\002'", "'\\002'");  // STX (Start of Text);
    ASSERT_EQ("'\\003'", "'\\003'");  // ETX (End of Text);
    ASSERT_EQ("'\\007'", "'\\007'");  // BEL (Bell);
    ASSERT_EQ("'\\010'", "'\\010'");  // BS (Backspace);
    ASSERT_EQ("'\\011'", "'\\011'");  // HT (Horizontal Tab) - same as '\t'
    ASSERT_EQ("'\\012'", "'\\012'");  // LF (Line Feed) - same as '\n'
    ASSERT_EQ("'\\015'", "'\\015'");  // CR (Carriage Return) - same as '\r'
    ASSERT_EQ("'\\032'", "'\\032'");  // SUB (Substitute);

    // Test empty quoted symbol (single quote)
    ASSERT_EQ("'", "0Ns");  // Empty quoted symbol should be parsed as a null symbol

    // Test basic string literals
    ASSERT_EQ("\"Hello, World!\"", "\"Hello, World!\"");
    ASSERT_EQ("\"\"", "\"\"");  // Empty string
    ASSERT_EQ("\"123\"", "\"123\"");

    // Test standard escape sequences in string literals
    ASSERT_EQ("\"Hello\\nWorld\"", "\"Hello\\nWorld\"");
    ASSERT_EQ("\"Hello\\rWorld\"", "\"Hello\\rWorld\"");
    ASSERT_EQ("\"Hello\\tWorld\"", "\"Hello\\tWorld\"");
    ASSERT_EQ("\"Hello\\\\World\"", "\"Hello\\\\World\"");
    ASSERT_EQ("\"Hello\\\"World\"", "\"Hello\\\"World\"");

    // Test octal escape sequences in string literals
    ASSERT_EQ("\"Hello\\001World\"", "\"Hello\\001World\"");  // SOH
    ASSERT_EQ("\"Hello\\002World\"", "\"Hello\\002World\"");  // STX
    ASSERT_EQ("\"Hello\\003World\"", "\"Hello\\003World\"");  // ETX
    ASSERT_EQ("\"Hello\\007World\"", "\"Hello\\007World\"");  // BEL
    ASSERT_EQ("\"Hello\\010World\"", "\"Hello\\010World\"");  // BS
    ASSERT_EQ("\"Hello\\011World\"", "\"Hello\\011World\"");  // HT
    ASSERT_EQ("\"Hello\\012World\"", "\"Hello\\012World\"");  // LF
    ASSERT_EQ("\"Hello\\015World\"", "\"Hello\\015World\"");  // CR

    // Test FIX protocol message with octal escapes
    ASSERT_EQ("\"8=FIX.4.2\\0019=006035=A49=CL156=TR34=152=20\"",
                   "\"8=FIX.4.2\\0019=006035=A49=CL156=TR34=152=20\"");

    // Test mixed escape sequences
    ASSERT_EQ("\"Mixed\\001\\n\\t\\015Escapes\"", "\"Mixed\\001\\n\\t\\015Escapes\"");
    return MUNIT_OK;
}

static MunitResult test_rf_cmp(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // Test character-to-string comparisons
    ASSERT_EQ("(== 'a' \"a\")", "true");
    ASSERT_EQ("(== 'a' \"b\")", "false");
    ASSERT_EQ("(== 'a' \"ab\")", "false");
    ASSERT_EQ("(== \"a\" 'a')", "true");
    ASSERT_EQ("(== \"ab\" 'a')", "false");
    ASSERT_EQ("(!= 'a' \"b\")", "true");
    ASSERT_EQ("(!= 'a' \"a\")", "false");
    ASSERT_EQ("(!= \"a\" 'b')", "true");
    ASSERT_EQ("(!= \"a\" 'a')", "false");
    ASSERT_EQ("(< 'a' \"b\")", "true");
    ASSERT_EQ("(< 'b' \"a\")", "false");
    ASSERT_EQ("(< \"a\" 'b')", "true");
    ASSERT_EQ("(< \"b\" 'a')", "false");
    ASSERT_EQ("(> 'b' \"a\")", "true");
    ASSERT_EQ("(> 'a' \"b\")", "false");
    ASSERT_EQ("(> \"b\" 'a')", "true");
    ASSERT_EQ("(> \"a\" 'b')", "false");
    ASSERT_EQ("(<= 'a' \"a\")", "true");
    ASSERT_EQ("(<= 'a' \"b\")", "true");
    ASSERT_EQ("(<= 'b' \"a\")", "false");
    ASSERT_EQ("(<= \"a\" 'a')", "true");
    ASSERT_EQ("(<= \"a\" 'b')", "true");
    ASSERT_EQ("(<= \"b\" 'a')", "false");
    ASSERT_EQ("(>= 'a' \"a\")", "true");
    ASSERT_EQ("(>= 'b' \"a\")", "true");
    ASSERT_EQ("(>= 'a' \"b\")", "false");
    ASSERT_EQ("(>= \"a\" 'a')", "true");
    ASSERT_EQ("(>= \"b\" 'a')", "true");
    ASSERT_EQ("(>= \"a\" 'b')", "false");

    // Test character-to-character comparisons
    ASSERT_EQ("(== 'a' 'a')", "true");
    ASSERT_EQ("(== 'a' 'b')", "false");
    ASSERT_EQ("(!= 'a' 'b')", "true");
    ASSERT_EQ("(!= 'a' 'a')", "false");
    ASSERT_EQ("(< 'a' 'b')", "true");
    ASSERT_EQ("(< 'b' 'a')", "false");
