static MunitResult test_rf_conditionals(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== BASIC IF TESTS ==========
    ASSERT_EQ("(if true 1 2)", "1");
    ASSERT_EQ("(if false 1 2)", "2");

    // ========== NESTED IF ==========
    ASSERT_EQ("(if true (if true 1 2) 3)", "1");
    ASSERT_EQ("(if true (if false 1 2) 3)", "2");
    ASSERT_EQ("(if false 1 (if true 2 3))", "2");

    // ========== IF WITH EXPRESSIONS ==========
    ASSERT_EQ("(if (> 5 3) (+ 1 1) (- 1 1))", "2");
    ASSERT_EQ("(if (< 5 3) (+ 1 1) (- 5 3))", "2");
    ASSERT_EQ("(if (== 1 1) \"yes\" \"no\")", "\"yes\"");

    // ========== IF WITH SIDE EFFECTS ==========
    ASSERT_EQ("(set y 0) (if true (set y 10) (set y 20)) y", "10");
    ASSERT_EQ("(set y 0) (if false (set y 10) (set y 20)) y", "20");

    // ========== CHAINED CONDITIONS ==========
    ASSERT_EQ("(set x 5) (if (< x 0) 'neg (if (== x 0) 'zero 'pos))", "'pos");
    ASSERT_EQ("(set x -3) (if (< x 0) 'neg (if (== x 0) 'zero 'pos))", "'neg");
    ASSERT_EQ("(set x 0) (if (< x 0) 'neg (if (== x 0) 'zero 'pos))", "'zero");
    return MUNIT_OK;
}

static MunitResult test_rf_dict(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== DICT CREATION ==========
    ASSERT_EQ("(dict [a b c] [1 2 3])", "{a:1 b:2 c:3}");
    ASSERT_EQ("(dict [x y] [10.0 20.0])", "{x:10.0 y:20.0}");
    ASSERT_EQ("(dict [] [])", "{}");

    // ========== DICT ACCESS ==========
    ASSERT_EQ("(set d (dict [a b c] [1 2 3])) (at d 'a)", "1");
    ASSERT_EQ("(set d (dict [a b c] [1 2 3])) (at d 'b)", "2");
    ASSERT_EQ("(set d (dict [a b c] [1 2 3])) (at d 'c)", "3");
    ASSERT_EQ("(set d (dict [a b c] [1 2 3])) (at d 'd)", "0Nl");  // missing key

    // ========== KEY FUNCTION ==========
    ASSERT_EQ("(key (dict [a b c] [1 2 3]))", "[a b c]");
    ASSERT_EQ("(key (dict [x] [10]))", "[x]");
    ASSERT_EQ("(key (table [a b] (list [1 2] [3 4])))", "[a b]");

    // ========== VALUE FUNCTION ==========
    ASSERT_EQ("(value (dict [a b c] [1 2 3]))", "[1 2 3]");
    ASSERT_EQ("(value (dict [x] [10]))", "[10]");
    ASSERT_EQ("(value (table [a b] (list [1 2] [3 4])))", "(list [1 2] [3 4])");

    // ========== NESTED DICT ==========
    ASSERT_EQ("(set d (dict [a b] (list 1 (dict [x y] [10 20])))) (at (at d 'b) 'x)", "10");

    // ========== DICT IN TABLE ROW ==========
    ASSERT_EQ("(first (table [a b] (list [1 2] [3 4])))", "{a:1 b:3}");
    ASSERT_EQ("(at (first (table [a b] (list [1 2] [3 4]))) 'a)", "1");
    return MUNIT_OK;
}

static MunitResult test_rf_list(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== LIST CREATION ==========
    ASSERT_EQ("(list 1 2 3)", "(list 1 2 3)");
    ASSERT_EQ("(list [1 2] [3 4])", "(list [1 2] [3 4])");
    ASSERT_EQ("(list 1 \"hello\" 'a)", "(list 1 \"hello\" 'a)");

    // ========== ENLIST ==========
    ASSERT_EQ("(enlist 5)", "[5]");
    ASSERT_EQ("(enlist 'a)", "['a]");
    ASSERT_EQ("(enlist \"hello\")", "(list \"hello\")");
    ASSERT_EQ("(enlist [1 2 3])", "(list [1 2 3])");

    // ========== AT (INDEXING) ==========
    ASSERT_EQ("(at [10 20 30 40] 0)", "10");
    ASSERT_EQ("(at [10 20 30 40] 2)", "30");
    ASSERT_EQ("(at [10 20 30 40] 3)", "40");
    ASSERT_EQ("(at [10 20 30 40] [0 2])", "[10 30]");  // multiple indices
    ASSERT_EQ("(at \"hello\" 1)", "'e'");
    ASSERT_EQ("(at \"hello\" [0 4])", "\"ho\"");

    // ========== AT ON TABLES ==========
    ASSERT_EQ("(at (table [a b] (list [1 2 3] [4 5 6])) 0)", "{a:1 b:4}");
    ASSERT_EQ("(at (table [a b] (list [1 2 3] [4 5 6])) 'a)", "[1 2 3]");

    // ========== TIL ==========
    ASSERT_EQ("(til 5)", "[0 1 2 3 4]");
    ASSERT_EQ("(til 0)", "[]");
    ASSERT_EQ("(til 1)", "[0]");

    // ========== TAKE ==========
    ASSERT_EQ("(take [1 2 3 4 5] 3)", "[1 2 3]");
    ASSERT_EQ("(take [1 2 3 4 5] -3)", "[3 4 5]");
    ASSERT_EQ("(take [1 2 3] 7)", "[1 2 3 1 2 3 1]");  // cyclic
    ASSERT_EQ("(take \"hello\" 3)", "\"hel\"");
    return MUNIT_OK;
}

static MunitResult test_rf_alter(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== ALTER SET ON VECTORS ==========
    ASSERT_EQ("(set v [1 2 3 4 5]) (alter 'v set 0 100) v", "[100 2 3 4 5]");

    // ========== ALTER CONCAT ON VECTORS ==========
    ASSERT_EQ("(set v [1 2 3]) (alter 'v concat 4) v", "[1 2 3 4]");
    return MUNIT_OK;
}

static MunitResult test_rf_null(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== NIL? TESTS ==========
    ASSERT_EQ("(nil? null)", "true");
    ASSERT_EQ("(nil? 0Nl)", "true");
    ASSERT_EQ("(nil? 0)", "false");
    ASSERT_EQ("(nil? 1)", "false");
    ASSERT_EQ("(nil? \"\")", "false");

    // ========== NULL PROPAGATION ==========
    ASSERT_EQ("(+ 1 0Nl)", "0Nl");
    ASSERT_EQ("(* 5 0Nl)", "0Nl");
    ASSERT_EQ("(+ [1 2 3] [0Nl 2 3])", "[0Nl 4 6]");

    // ========== NULL COMPARISONS ==========
    ASSERT_EQ("(== 0Nl 0Nl)", "true");
    ASSERT_EQ("(== null null)", "true");

    // ========== NULL IN TABLES ==========
    ASSERT_EQ(
        "(set t (table [a b] (list [1 0Nl 3] [4 5 6])))"
        "(at (at t 'a) 1)",
        "0Nl");

    // ========== INT64_MIN IS A VALID VALUE (not a sentinel) ==========
    ASSERT_EQ("(+ 0 -9223372036854775807)", "-9223372036854775807");
    ASSERT_EQ("(- 0 9223372036854775807)", "-9223372036854775807");

    return MUNIT_OK;
}

static MunitResult test_rf_set_ops(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== UNION TESTS ==========
    ASSERT_EQ("(union [1 2 3] [3 4 5])", "[1 2 3 4 5]");
    ASSERT_EQ("(union [1 2 3] [1 2 3])", "[1 2 3]");
    ASSERT_EQ("(union [] [1 2 3])", "[1 2 3]");
    ASSERT_EQ("(union [1 2 3] [])", "[1 2 3]");
    ASSERT_EQ("(union ['a 'b] ['b 'c])", "[a b c]");

    // ========== SECT (INTERSECTION) TESTS ==========
    ASSERT_EQ("(sect [1 2 3 4] [2 4 6])", "[2 4]");
    ASSERT_EQ("(sect [1 2 3] [4 5 6])", "[]");
    ASSERT_EQ("(sect [1 2 3] [1 2 3])", "[1 2 3]");
    ASSERT_EQ("(sect ['a 'b 'c] ['b 'c 'd])", "[b c]");

    // ========== WITHIN TESTS ==========
    ASSERT_EQ("(within [5] [1 10])", "[true]");
    ASSERT_EQ("(within [0] [1 10])", "[false]");
    ASSERT_EQ("(within [11] [1 10])", "[false]");
    ASSERT_EQ("(within [5 0 15] [1 10])", "[true false false]");
    return MUNIT_OK;
}

static MunitResult test_rf_cast(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== B8 (BOOLEAN) ATOM CASTS ==========
    // b8 <- u8 (atom to atom - use lowercase)
    ASSERT_EQ("(as 'b8 0x00)", "false");
    ASSERT_EQ("(as 'b8 0x01)", "true");
    ASSERT_EQ("(as 'b8 0xFF)", "true");
    // b8 <- i16
    ASSERT_EQ("(as 'b8 0h)", "false");
    ASSERT_EQ("(as 'b8 1h)", "true");
    ASSERT_EQ("(as 'b8 -1h)", "true");
    // b8 <- i32
    ASSERT_EQ("(as 'b8 0i)", "false");
    ASSERT_EQ("(as 'b8 1i)", "true");
    ASSERT_EQ("(as 'b8 -1i)", "true");
    // b8 <- i64
    ASSERT_EQ("(as 'b8 0)", "false");
    ASSERT_EQ("(as 'b8 1)", "true");
    ASSERT_EQ("(as 'b8 -1)", "true");
    // b8 <- f64
    ASSERT_EQ("(as 'b8 0.0)", "false");
    ASSERT_EQ("(as 'b8 1.0)", "true");
    ASSERT_EQ("(as 'b8 -1.5)", "true");
    // b8 <- date (2000.01.01 is epoch/day 0, so it's false; 2000.01.02 is day 1, so true)
    ASSERT_EQ("(as 'b8 2000.01.01)", "false");
    ASSERT_EQ("(as 'b8 2000.01.02)", "true");
    // b8 <- time (00:00:00.000 is 0ms, so false; 00:00:01.000 is 1000ms, so true)
    ASSERT_EQ("(as 'b8 00:00:00.000)", "false");
    ASSERT_EQ("(as 'b8 00:00:01.000)", "true");
    // b8 <- timestamp (epoch is 0, so false; 1 nanosecond after is true)
    ASSERT_EQ("(as 'b8 2000.01.01D00:00:00.000000000)", "false");
    ASSERT_EQ("(as 'b8 2000.01.01D00:00:00.000000001)", "true");
    // b8 <- String (empty string returns empty vector due to early check)
    ASSERT_EQ("(as 'b8 \"a\")", "true");
    ASSERT_EQ("(as 'b8 \"hello\")", "true");

    // ========== B8 VECTOR CASTS ==========
    ASSERT_EQ("(as 'B8 [0h 1h 2h])", "[false true true]");
    ASSERT_EQ("(as 'B8 [0i 1i -1i])", "[false true true]");
    ASSERT_EQ("(as 'B8 [0 1 -1])", "[false true true]");
    ASSERT_EQ("(as 'B8 [0.0 1.0 -1.5])", "[false true true]");

    // ========== U8 (BYTE) ATOM CASTS ==========
    // u8 <- b8
    ASSERT_EQ("(as 'u8 false)", "0x00");
    ASSERT_EQ("(as 'u8 true)", "0x01");
    // u8 <- i16
    ASSERT_EQ("(as 'u8 0h)", "0x00");
    ASSERT_EQ("(as 'u8 255h)", "0xFF");
    // u8 <- i32
    ASSERT_EQ("(as 'u8 0i)", "0x00");
    ASSERT_EQ("(as 'u8 255i)", "0xFF");
    // u8 <- i64
    ASSERT_EQ("(as 'u8 0)", "0x00");
    ASSERT_EQ("(as 'u8 255)", "0xFF");
    // u8 <- f64
    ASSERT_EQ("(as 'u8 0.0)", "0x00");
    ASSERT_EQ("(as 'u8 255.9)", "0xFF");
    // u8 <- String
    ASSERT_EQ("(as 'u8 \"42\")", "0x2A");

    // ========== U8 VECTOR CASTS ==========
    ASSERT_EQ("(as 'U8 [0h 1h 255h])", "[0x00 0x01 0xFF]");
    ASSERT_EQ("(as 'U8 [0i 1i 255i])", "[0x00 0x01 0xFF]");
    ASSERT_EQ("(as 'U8 [0 1 255])", "[0x00 0x01 0xFF]");
    ASSERT_EQ("(as 'U8 [0.0 1.0 255.0])", "[0x00 0x01 0xFF]");

    // ========== I16 (SHORT) ATOM CASTS ==========
    // i16 <- b8
    ASSERT_EQ("(as 'i16 false)", "0h");
    ASSERT_EQ("(as 'i16 true)", "1h");
    // i16 <- u8
    ASSERT_EQ("(as 'i16 0x00)", "0h");
    ASSERT_EQ("(as 'i16 0xFF)", "255h");
    // i16 <- i32
    ASSERT_EQ("(as 'i16 0i)", "0h");
    ASSERT_EQ("(as 'i16 100i)", "100h");
    // i16 <- i64
    ASSERT_EQ("(as 'i16 0)", "0h");
    ASSERT_EQ("(as 'i16 100)", "100h");
    // i16 <- f64
    ASSERT_EQ("(as 'i16 0.0)", "0h");
    ASSERT_EQ("(as 'i16 100.9)", "100h");
    // i16 <- date
    ASSERT_EQ("(type (as 'i16 2000.01.01))", "'i16");
    // i16 <- time
    ASSERT_EQ("(type (as 'i16 00:00:01.000))", "'i16");
    // i16 <- timestamp
    ASSERT_EQ("(type (as 'i16 2000.01.01D00:00:00.000000001))", "'i16");
    // i16 <- String
    ASSERT_EQ("(as 'i16 \"42\")", "42h");
    ASSERT_EQ("(as 'i16 \"-100\")", "-100h");

    // ========== I16 VECTOR CASTS ==========
    ASSERT_EQ("(as 'I16 [false true])", "[0h 1h]");
    ASSERT_EQ("(as 'I16 [0x00 0xFF])", "[0h 255h]");
    ASSERT_EQ("(as 'I16 [0i 100i -100i])", "[0h 100h -100h]");
    ASSERT_EQ("(as 'I16 [0 100 -100])", "[0h 100h -100h]");
    ASSERT_EQ("(as 'I16 [0.0 100.9 -100.9])", "[0h 100h -100h]");

    // ========== I32 (INT) ATOM CASTS ==========
    // i32 <- b8
    ASSERT_EQ("(as 'i32 false)", "0i");
    ASSERT_EQ("(as 'i32 true)", "1i");
    // i32 <- u8
    ASSERT_EQ("(as 'i32 0x00)", "0i");
    ASSERT_EQ("(as 'i32 0xFF)", "255i");
    // i32 <- i16
    ASSERT_EQ("(as 'i32 0h)", "0i");
    ASSERT_EQ("(as 'i32 -100h)", "-100i");
    // i32 <- i64
    ASSERT_EQ("(as 'i32 0)", "0i");
    ASSERT_EQ("(as 'i32 1000000)", "1000000i");
    // i32 <- f64
    ASSERT_EQ("(as 'i32 0.0)", "0i");
    ASSERT_EQ("(as 'i32 100.9)", "100i");
    ASSERT_EQ("(as 'i32 -100.9)", "-100i");
    // i32 <- date
    ASSERT_EQ("(type (as 'i32 2000.01.01))", "'i32");
    // i32 <- time
    ASSERT_EQ("(type (as 'i32 00:00:01.000))", "'i32");
    // i32 <- timestamp
    ASSERT_EQ("(type (as 'i32 2000.01.01D00:00:00.000000001))", "'i32");
    // i32 <- String
    ASSERT_EQ("(as 'i32 \"42\")", "42i");
    ASSERT_EQ("(as 'i32 \"-1000000\")", "-1000000i");

    // ========== I32 VECTOR CASTS ==========
    ASSERT_EQ("(as 'I32 [false true])", "[0i 1i]");
    ASSERT_EQ("(as 'I32 [0x00 0xFF])", "[0i 255i]");
    ASSERT_EQ("(as 'I32 [0h 100h -100h])", "[0i 100i -100i]");
    ASSERT_EQ("(as 'I32 [0 100 -100])", "[0i 100i -100i]");
    ASSERT_EQ("(as 'I32 [0.0 100.9 -100.9])", "[0i 100i -100i]");

    // ========== I64 (LONG) ATOM CASTS ==========
    // i64 <- b8
    ASSERT_EQ("(as 'i64 false)", "0");
    ASSERT_EQ("(as 'i64 true)", "1");
    // i64 <- u8
    ASSERT_EQ("(as 'i64 0x00)", "0");
    ASSERT_EQ("(as 'i64 0xFF)", "255");
    // i64 <- i16
    ASSERT_EQ("(as 'i64 0h)", "0");
    ASSERT_EQ("(as 'i64 -100h)", "-100");
    // i64 <- i32
    ASSERT_EQ("(as 'i64 0i)", "0");
    ASSERT_EQ("(as 'i64 -1000000i)", "-1000000");
    // i64 <- f64
    ASSERT_EQ("(as 'i64 0.0)", "0");
    ASSERT_EQ("(as 'i64 100.9)", "100");
    // i64 <- date
    ASSERT_EQ("(type (as 'i64 2000.01.01))", "'i64");
    // i64 <- time
    ASSERT_EQ("(type (as 'i64 00:00:01.000))", "'i64");
    // i64 <- timestamp
    ASSERT_EQ("(type (as 'i64 2000.01.01D00:00:00.000000001))", "'i64");
    // i64 <- String
    ASSERT_EQ("(as 'i64 \"42\")", "42");
    ASSERT_EQ("(as 'i64 \"-9999999999\")", "-9999999999");

    // ========== I64 VECTOR CASTS ==========
    ASSERT_EQ("(as 'I64 [false true])", "[0 1]");
    ASSERT_EQ("(as 'I64 [0x00 0xFF])", "[0 255]");
    ASSERT_EQ("(as 'I64 [0h 100h -100h])", "[0 100 -100]");
    ASSERT_EQ("(as 'I64 [0i 100i -100i])", "[0 100 -100]");
    ASSERT_EQ("(as 'I64 [0.0 100.9 -100.9])", "[0 100 -100]");

    // ========== F64 (FLOAT) ATOM CASTS ==========
    // f64 <- b8
    ASSERT_EQ("(as 'f64 false)", "0.00");
    ASSERT_EQ("(as 'f64 true)", "1.00");
    // f64 <- u8
    ASSERT_EQ("(as 'f64 0x00)", "0.00");
    ASSERT_EQ("(as 'f64 0xFF)", "255.00");
    // f64 <- i16
    ASSERT_EQ("(as 'f64 0h)", "0.00");
    ASSERT_EQ("(as 'f64 -100h)", "-100.00");
    // f64 <- i32
    ASSERT_EQ("(as 'f64 0i)", "0.00");
    ASSERT_EQ("(as 'f64 1000000i)", "1000000.00");
    // f64 <- i64
    ASSERT_EQ("(as 'f64 0)", "0.00");
    ASSERT_EQ("(as 'f64 1000000)", "1000000.00");
    // f64 <- date
    ASSERT_EQ("(type (as 'f64 2000.01.01))", "'f64");
    // f64 <- time
    ASSERT_EQ("(type (as 'f64 00:00:01.000))", "'f64");
    // f64 <- timestamp
    ASSERT_EQ("(type (as 'f64 2000.01.01D00:00:00.000000001))", "'f64");
    // f64 <- String
    ASSERT_EQ("(as 'f64 \"42.5\")", "42.50");
    ASSERT_EQ("(as 'f64 \"-100.25\")", "-100.25");

    // ========== F64 VECTOR CASTS ==========
    ASSERT_EQ("(as 'F64 [false true])", "[0.0 1.0]");
    ASSERT_EQ("(as 'F64 [0x00 0xFF])", "[0.0 255.0]");
    ASSERT_EQ("(as 'F64 [0h 100h])", "[0.0 100.0]");
    ASSERT_EQ("(as 'F64 [0i 100i])", "[0.0 100.0]");
    ASSERT_EQ("(as 'F64 [0 100])", "[0.0 100.0]");

    // ========== DATE ATOM CASTS ==========
    // date <- b8
    ASSERT_EQ("(type (as 'date false))", "'date");
    ASSERT_EQ("(type (as 'date true))", "'date");
    // date <- u8
    ASSERT_EQ("(type (as 'date 0x00))", "'date");
    // date <- i16
    ASSERT_EQ("(type (as 'date 0h))", "'date");
    // date <- i32
    ASSERT_EQ("(type (as 'date 0i))", "'date");
    ASSERT_EQ("(as 'date 0i)", "2000.01.01");
    // date <- i64
    ASSERT_EQ("(type (as 'date 0))", "'date");
    ASSERT_EQ("(as 'date 0)", "2000.01.01");
    // date <- f64
    ASSERT_EQ("(type (as 'date 0.0))", "'date");
    // date <- time (value copy)
    ASSERT_EQ("(type (as 'date 00:00:01.000))", "'date");
    // date <- timestamp
    ASSERT_EQ("(type (as 'date 2000.01.01D00:00:00.000000001))", "'date");
    // date <- String
    ASSERT_EQ("(as 'date \"2024.03.20\")", "2024.03.20");

    // ========== DATE VECTOR CASTS ==========
    ASSERT_EQ("(type (as 'DATE [0 1 2]))", "'DATE");
    ASSERT_EQ("(type (as 'DATE [0i 1i 2i]))", "'DATE");
    ASSERT_EQ("(type (as 'DATE [0h 1h 2h]))", "'DATE");
    ASSERT_EQ("(type (as 'DATE [0.0 1.0 2.0]))", "'DATE");

    // ========== TIME ATOM CASTS ==========
    // time <- b8
    ASSERT_EQ("(type (as 'time false))", "'time");
    ASSERT_EQ("(type (as 'time true))", "'time");
    // time <- u8
    ASSERT_EQ("(type (as 'time 0x00))", "'time");
    // time <- i16
    ASSERT_EQ("(type (as 'time 0h))", "'time");
    // time <- i32
    ASSERT_EQ("(type (as 'time 0i))", "'time");
    ASSERT_EQ("(as 'time 0i)", "00:00:00.000");
    // time <- i64
    ASSERT_EQ("(type (as 'time 0))", "'time");
    ASSERT_EQ("(as 'time 1000)", "00:00:01.000");
    // time <- f64
    ASSERT_EQ("(type (as 'time 0.0))", "'time");
    // time <- date (value copy)
    ASSERT_EQ("(type (as 'time 2000.01.01))", "'time");
    // time <- timestamp
    ASSERT_EQ("(type (as 'time 2000.01.01D00:00:00.000000001))", "'time");
    // time <- String
    ASSERT_EQ("(as 'time \"12:30:45.123\")", "12:30:45.123");
    ASSERT_EQ("(as 'time \"20:00:00\")", "20:00:00.000");
    ASSERT_EQ("(as 'time \"20:00:00.\")", "20:00:00.000");
    ASSERT_EQ("(as 'time \"20:00:00.0\")", "20:00:00.000");

    // time literals with 1-3 digit fractional seconds
    ASSERT_EQ("10:00:00.1", "10:00:00.001");
    ASSERT_EQ("10:00:00.01", "10:00:00.001");
    ASSERT_EQ("10:00:00.12", "10:00:00.012");
    ASSERT_EQ("10:00:00.011", "10:00:00.011");
    ASSERT_EQ("10:00:00.123", "10:00:00.123");

    // ========== TIME VECTOR CASTS ==========
    ASSERT_EQ("(type (as 'TIME [0 1000 2000]))", "'TIME");
    ASSERT_EQ("(type (as 'TIME [0i 1000i 2000i]))", "'TIME");
    ASSERT_EQ("(type (as 'TIME [0h 1h 2h]))", "'TIME");
    ASSERT_EQ("(type (as 'TIME [0.0 1000.0 2000.0]))", "'TIME");

    // ========== TIMESTAMP ATOM CASTS ==========
    // timestamp <- b8
    ASSERT_EQ("(type (as 'timestamp false))", "'timestamp");
    ASSERT_EQ("(type (as 'timestamp true))", "'timestamp");
    // timestamp <- u8
    ASSERT_EQ("(type (as 'timestamp 0x00))", "'timestamp");
    // timestamp <- i16
    ASSERT_EQ("(type (as 'timestamp 0h))", "'timestamp");
    // timestamp <- i32
    ASSERT_EQ("(type (as 'timestamp 0i))", "'timestamp");
    // timestamp <- i64
    ASSERT_EQ("(type (as 'timestamp 0))", "'timestamp");
    ASSERT_EQ("(as 'timestamp 0)", "2000.01.01D00:00:00.000000000");
    // timestamp <- f64
    ASSERT_EQ("(type (as 'timestamp 0.0))", "'timestamp");
    // timestamp <- date
    ASSERT_EQ("(type (as 'timestamp 2000.01.01))", "'timestamp");
    // timestamp <- time
    ASSERT_EQ("(type (as 'timestamp 00:00:01.000))", "'timestamp");
    // timestamp <- String
    ASSERT_EQ("(as 'timestamp \"2024.03.20D12:30:45.123456789\")", "2024.03.20D12:30:45.123456789");

    // ========== TIMESTAMP VECTOR CASTS ==========
    ASSERT_EQ("(type (as 'TIMESTAMP [0 1 2]))", "'TIMESTAMP");
    ASSERT_EQ("(type (as 'TIMESTAMP [0i 1i 2i]))", "'TIMESTAMP");
    ASSERT_EQ("(type (as 'TIMESTAMP [0h 1h 2h]))", "'TIMESTAMP");
    ASSERT_EQ("(type (as 'TIMESTAMP [0.0 1.0 2.0]))", "'TIMESTAMP");

    // ========== SYMBOL ATOM CASTS ==========
    // symbol <- b8
    ASSERT_EQ("(as 'symbol false)", "'0");
    ASSERT_EQ("(as 'symbol true)", "'1");
    // symbol <- u8
    ASSERT_EQ("(as 'symbol 0x00)", "'0");
    ASSERT_EQ("(as 'symbol 0xFF)", "'255");
    // symbol <- i16
    ASSERT_EQ("(as 'symbol 42h)", "'42");
    ASSERT_EQ("(as 'symbol -100h)", "'-100");
    // symbol <- i32
    ASSERT_EQ("(as 'symbol 42i)", "'42");
    ASSERT_EQ("(as 'symbol -1000000i)", "'-1000000");
    // symbol <- i64
    ASSERT_EQ("(as 'symbol 42)", "'42");
    ASSERT_EQ("(as 'symbol -9999999999)", "'-9999999999");
    // symbol <- f64
    ASSERT_EQ("(type (as 'symbol 42.5))", "'symbol");
    // symbol <- date
    ASSERT_EQ("(type (as 'symbol 2024.03.20))", "'symbol");
    // symbol <- time
    ASSERT_EQ("(type (as 'symbol 12:30:45.123))", "'symbol");
    // symbol <- timestamp
    ASSERT_EQ("(type (as 'symbol 2024.03.20D12:30:45.123456789))", "'symbol");
    // symbol <- guid
    ASSERT_EQ("(type (as 'symbol (as 'guid \"d49f18a4-1969-49e8-9b8a-6bb9a4832eea\")))", "'symbol");
    // symbol <- String
    ASSERT_EQ("(as 'symbol \"hello\")", "'hello");

    // ========== SYMBOL VECTOR CASTS ==========
    // SYMBOL <- I64
    ASSERT_EQ("(type (as 'SYMBOL (til 5)))", "'SYMBOL");
    ASSERT_EQ("(as 'SYMBOL [0 1 2])", "[0 1 2]");
    ASSERT_EQ("(as 'SYMBOL [42 -100 999])", "[42 -100 999]");
    ASSERT_EQ("(count (as 'SYMBOL (til 1000)))", "1000");

    // ========== STRING/CHAR CASTS ==========
    ASSERT_EQ("(as 'STR 'hello)", "\"hello\"");
    ASSERT_EQ("(as 'STR 123)", "\"123\"");
    ASSERT_EQ("(as 'STR 123i)", "\"123\"");
    ASSERT_EQ("(as 'STR 123h)", "\"123\"");
    ASSERT_EQ("(as 'STR 123.45)", "\"123.45\"");
    ASSERT_EQ("(as 'STR true)", "\"true\"");
    ASSERT_EQ("(as 'STR false)", "\"false\"");
    ASSERT_EQ("(as 'STR 2024.03.20)", "\"2024.03.20\"");
    ASSERT_EQ("(as 'STR 12:30:45.123)", "\"12:30:45.123\"");


    // ========== GUID CASTS ==========
    ASSERT_EQ("(type (as 'guid \"d49f18a4-1969-49e8-9b8a-6bb9a4832eea\"))", "'guid");

    // ========== IDENTITY CASTS (same type) ==========
    ASSERT_EQ("(as 'b8 true)", "true");
    ASSERT_EQ("(as 'u8 0xFF)", "0xFF");
    ASSERT_EQ("(as 'i16 100h)", "100h");
    ASSERT_EQ("(as 'i32 100i)", "100i");
    ASSERT_EQ("(as 'i64 100)", "100");
    ASSERT_EQ("(as 'f64 100.5)", "100.50");
    ASSERT_EQ("(as 'date 2024.03.20)", "2024.03.20");
    ASSERT_EQ("(as 'time 12:30:45.123)", "12:30:45.123");
    ASSERT_EQ("(as 'symbol 'hello)", "'hello");

    // ========== EMPTY VECTOR CASTS ==========
    ASSERT_EQ("(type (as 'B8 []))", "'B8");
    ASSERT_EQ("(type (as 'U8 []))", "'U8");
    ASSERT_EQ("(type (as 'I16 []))", "'I16");
    ASSERT_EQ("(type (as 'I32 []))", "'I32");
    ASSERT_EQ("(type (as 'I64 []))", "'I64");
    ASSERT_EQ("(type (as 'F64 []))", "'F64");
    ASSERT_EQ("(type (as 'DATE []))", "'DATE");
    ASSERT_EQ("(type (as 'TIME []))", "'TIME");
    ASSERT_EQ("(type (as 'TIMESTAMP []))", "'TIMESTAMP");

    // ========== TABLE/DICT CASTS ==========
    ASSERT_EQ("(type (as 'TABLE {a: [1 2 3] b: [4 5 6]}))", "'TABLE");
    ASSERT_EQ("(type (as 'DICT (as 'TABLE {a: [1 2 3] b: [4 5 6]})))", "'DICT");

    // ========== LIST TO VECTOR CASTS ==========
    ASSERT_EQ("(as 'I64 (list 1 2 3))", "[1 2 3]");
    ASSERT_EQ("(as 'I32 (list 1i 2i 3i))", "[1i 2i 3i]");
    ASSERT_EQ("(as 'F64 (list 1.0 2.0 3.0))", "[1.0 2.0 3.0]");
    ASSERT_EQ("(as 'B8 (list true false true))", "[true false true]");

    // ========== PARALLEL CAST (large vectors) ==========
    // i64 -> i32 (large vector triggers parallel processing)
    ASSERT_EQ("(sum (as 'I32 (til 100000)))", "704982704i");  // sum of 0..99999 as i32
    // i64 -> f64
    ASSERT_EQ("(sum (as 'F64 (til 100000)))", "4999950000.0");
    // i32 -> i64
    ASSERT_EQ("(sum (as 'I64 (as 'I32 (til 100000))))", "4999950000");
    // i64 -> i16
    ASSERT_EQ("(count (as 'I16 (til 100000)))", "100000");
    // i64 -> u8
    ASSERT_EQ("(count (as 'U8 (til 100000)))", "100000");
    // f64 -> i64
    ASSERT_EQ("(sum (as 'I64 (as 'F64 (til 100000))))", "4999950000");
    return MUNIT_OK;
}

static MunitResult test_rf_lambda(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== BASIC LAMBDA ==========
    ASSERT_EQ("((fn [x] (+ x 1)) 5)", "6");
    ASSERT_EQ("((fn [x y] (+ x y)) 3 4)", "7");
    ASSERT_EQ("((fn [] 42))", "42");

    // ========== LAMBDA WITH MULTIPLE ARGS ==========
    ASSERT_EQ("((fn [a b c] (+ a (+ b c))) 1 2 3)", "6");
    ASSERT_EQ("((fn [x y z] (* x (* y z))) 2 3 4)", "24");

    // ========== STORED LAMBDA ==========
    ASSERT_EQ("(set f (fn [x] (* x x))) (f 5)", "25");
    ASSERT_EQ("(set add (fn [a b] (+ a b))) (add 10 20)", "30");

    // ========== LAMBDA WITH MAP ==========
    ASSERT_EQ("(map (fn [x] (* x 2)) [1 2 3 4 5])", "[2 4 6 8 10]");
    ASSERT_EQ("(map (fn [x] (+ x 10)) [0 1 2])", "[10 11 12]");

    // ========== LAMBDA WITH FILTER/WHERE ==========
    ASSERT_EQ("(filter [1 2 3 4 5 6] (map (fn [x] (> x 3)) [1 2 3 4 5 6]))", "[4 5 6]");

    // ========== LAMBDA WITH CONDITIONALS ==========
    ASSERT_EQ("((fn [x] (if (> x 0) 'pos 'neg)) 5)", "'pos");
    ASSERT_EQ("((fn [x] (if (> x 0) 'pos 'neg)) -5)", "'neg");

    // ========== RECURSIVE-STYLE (SELF) ==========
    ASSERT_EQ("(set factorial (fn [n] (if (<= n 1) 1 (* n (factorial (- n 1)))))) (factorial 5)", "120");
    return MUNIT_OK;
}

static MunitResult test_rf_group(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== BASIC GROUP ==========
    ASSERT_EQ("(group [a a b b c])", "{a:[0 1] b:[2 3] c:[4]}");
    ASSERT_EQ("(group [1 1 2 2 3])", "{1:[0 1] 2:[2 3] 3:[4]}");
    ASSERT_EQ("(group [true false true false])", "{true:[0 2] false:[1 3]}");

    // ========== GROUP ON EMPTY ==========
    ASSERT_EQ("(group [])", "{}");

    // ========== GROUP WITH UNIQUE VALUES ==========
    ASSERT_EQ("(group [a b c])", "{a:[0] b:[1] c:[2]}");

    // ========== SELECT WITH BY (GROUPBY) ==========
    ASSERT_EQ(
        "(set t (table [Category Value] (list [a a b b] [10 20 30 40])))"
        "(select {from: t Sum: (sum Value) by: Category})",
        "(table [Category Sum] (list [a b] [30 70]))");

    ASSERT_EQ(
        "(set t (table [Category Value] (list [a a b b] [10 20 30 40])))"
        "(select {from: t Count: (count Value) by: Category})",
        "(table [Category Count] (list [a b] [2 2]))");

    // ========== UPDATE WITH BY ==========
    ASSERT_EQ(
        "(set t (table [Group Value] (list [a a b b] [10 20 30 40])))"
        "(update {from: 't GroupSum: (sum Value) by: Group})"
        "t",
        "(table [Group Value GroupSum] (list [a a b b] [10 20 30 40] [30 30 70 70]))");

    // ========== GROUP BY BOOL ==========
    ASSERT_EQ(
        "(set t (table [Flag Value] (list [true false true false] [10 20 30 40])))"
        "(select {from: t Sum: (sum Value) by: Flag})",
        "(table [Flag Sum] (list [true false] [40 60]))");

    // ========== GROUP BY STRING COLUMN ==========
    // Tests for grouping by list of strings (TYPE_LIST of TYPE_C8)
    // This tests the fix for parallel radix partitioning bug where identical strings
    // at different memory locations were incorrectly counted as different groups

    // Basic group by string list
    ASSERT_EQ("(group (list \"apple\" \"banana\" \"apple\" \"cherry\" \"banana\"))",
                   "{\"apple\":[0 2] \"banana\":[1 4] \"cherry\":[3]}");

    // Select with group by string column
    ASSERT_EQ(
        "(set t (table [Name Value] (list (list \"alice\" \"bob\" \"alice\" \"bob\") [10 20 30 40])))"
        "(select {from: t Sum: (sum Value) by: Name})",
        "(table [Name Sum] (list (list \"alice\" \"bob\") [40 60]))");

    // Count by string column
    ASSERT_EQ(
        "(set t (table [City Population] (list (list \"NYC\" \"LA\" \"NYC\" \"LA\" \"NYC\") [100 200 150 250 120])))"
        "(select {from: t Total: (sum Population) Count: (count Population) by: City})",
        "(table [City Total Count] (list (list \"NYC\" \"LA\") [370 450] [3 2]))");

    // Group by string with more unique values (to test parallel partitioning)
    ASSERT_EQ(
        "(set t (table [Category Amount] (list "
        "(list \"cat1\" \"cat2\" \"cat3\" \"cat1\" \"cat2\" \"cat3\" \"cat1\" \"cat2\") "
        "[10 20 30 40 50 60 70 80])))"
        "(select {from: t Sum: (sum Amount) by: Category})",
        "(table [Category Sum] (list (list \"cat1\" \"cat2\" \"cat3\") [120 150 90]))");

    // Update with group by string
    ASSERT_EQ(
        "(set t (table [Type Value] (list (list \"A\" \"B\" \"A\" \"B\") [10 20 30 40])))"
        "(update {from: 't TypeSum: (sum Value) by: Type})"
        "t",
        "(table [Type Value TypeSum] (list (list \"A\" \"B\" \"A\" \"B\") [10 20 30 40] [40 60 40 60]))");
    return MUNIT_OK;
}

static MunitResult test_rf_find(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== FIND IN VECTOR ==========
    ASSERT_EQ("(find [10 20 30 40] 30)", "2");
    ASSERT_EQ("(find [10 20 30 40] 50)", "0Nl");  // not found
    ASSERT_EQ("(find [10 20 30 40] 10)", "0");
    ASSERT_EQ("(find ['a 'b 'c] 'b)", "1");
    ASSERT_EQ("(find \"hello\" 'l')", "2");

    // ========== FIND MULTIPLE ==========
    ASSERT_EQ("(find [10 20 30 40] [20 40])", "[1 3]");
    ASSERT_EQ("(find ['a 'b 'c 'd] ['c 'a])", "[2 0]");
    ASSERT_EQ("(find [1 2 3] [4 2 5])", "[0Nl 1 0Nl]");

    // ========== FIND IN EMPTY ARRAY ==========
    ASSERT_EQ("(find [] 1)", "0Nl");
    ASSERT_EQ("(find [] [1 2 3])", "[]");  // Returns empty when source is empty

    // ========== FIND WITH DIFFERENT TYPE WIDTHS (index_find_i8) ==========
    ASSERT_EQ("(find \"abc\" 'b')", "1");
    ASSERT_EQ("(find \"abc\" 'z')", "0Nl");
    ASSERT_EQ("(find \"\" 'a')", "0Nl");

    // ========== FIND WITH i64 (index_find_i64) ==========
    ASSERT_EQ("(find [1000000000 2000000000 3000000000] 2000000000)", "1");
    ASSERT_EQ("(find [1000000000 2000000000] 9999999999)", "0Nl");

    // ========== FIND WITH SYMBOLS ==========
    ASSERT_EQ("(find ['apple 'banana 'cherry] 'banana)", "1");
    ASSERT_EQ("(find ['a] 'a)", "0");
    ASSERT_EQ("(find ['a] 'b)", "0Nl");
    return MUNIT_OK;
}

static MunitResult test_rf_rand(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== BASIC RAND ==========
    ASSERT_EQ("(count (rand 10 100))", "10");  // 10 random values in [0,100);
    ASSERT_EQ("(type (rand 5 100))", "'I64");  // int random

    // ========== VERIFY RANGE ==========
    ASSERT_EQ("(and (>= (min (rand 100 10)) 0) (< (max (rand 100 10)) 10))", "true");
    return MUNIT_OK;
}

static MunitResult test_rf_unary_ops(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== NEG TESTS ==========
    ASSERT_EQ("(neg 5)", "-5");
    ASSERT_EQ("(neg -5)", "5");
    ASSERT_EQ("(neg [1 -2 3 -4])", "[-1 2 -3 4]");
    ASSERT_EQ("(neg 5.0)", "-5.0");

    // ========== NOT TESTS ==========
    ASSERT_EQ("(not true)", "false");
    ASSERT_EQ("(not false)", "true");
    ASSERT_EQ("(not [true false true])", "[false true false]");

    // ========== WHERE TESTS ==========
    ASSERT_EQ("(where [true false true false true])", "[0 2 4]");
    ASSERT_EQ("(where [false false false])", "[]");
    ASSERT_EQ("(where [true true true])", "[0 1 2]");
    ASSERT_EQ("(where (> [1 2 3 4 5] 3))", "[3 4]");
    return MUNIT_OK;
}

static MunitResult test_rf_string_ops(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== STRING CONCAT ==========
    ASSERT_EQ("(concat \"hel\" \"lo\")", "\"hello\"");
    ASSERT_EQ("(concat \"\" \"test\")", "\"test\"");
    ASSERT_EQ("(concat \"test\" \"\")", "\"test\"");

    // ========== STRING COUNT ==========
    ASSERT_EQ("(count \"hello\")", "5");
    ASSERT_EQ("(count \"\")", "0");

    // ========== STRING INDEXING ==========
    ASSERT_EQ("(at \"hello\" 0)", "'h'");
    ASSERT_EQ("(at \"hello\" 4)", "'o'");

    // ========== STRING TAKE ==========
    ASSERT_EQ("(take \"hello\" 3)", "\"hel\"");
    ASSERT_EQ("(take \"hello\" -2)", "\"lo\"");

    // ========== STRING FIRST/LAST ==========
    ASSERT_EQ("(first \"hello\")", "'h'");
    ASSERT_EQ("(last \"hello\")", "'o'");
    return MUNIT_OK;
}

static MunitResult test_rf_do_let(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== DO TESTS ==========
    ASSERT_EQ("(do (set x 1) (set y 2) (+ x y))", "3");
    ASSERT_EQ("(do 1 2 3)", "3");  // returns last
    return MUNIT_OK;
}

static MunitResult test_rf_error(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== TRY WITH SUCCESS ==========
    ASSERT_EQ("(try (+ 1 2) (fn [e] 0))", "3");

    // ========== TRY WITH ERROR ==========
    ASSERT_EQ("(try (raise \"error\") (fn [e] 99))", "99");

    // ========== NESTED TRY ==========
    ASSERT_EQ("(try (try (raise \"inner\") (fn [e] (raise \"outer\"))) (fn [e] 42))", "42");
    return MUNIT_OK;
}

static MunitResult test_rf_safety(const void* params, void* fixture) {
    (void)params; (void)fixture;

    // ========== TIL NEGATIVE LENGTH ==========
    ASSERT_ER("(til -1)", "domain");
    ASSERT_ER("(til -100)", "domain");

    // ========== RAND NEGATIVE/ZERO ==========
    ASSERT_ER("(rand -1 10)", "domain");
    ASSERT_ER("(rand 5 0)", "domain");
    ASSERT_ER("(rand 5 -1)", "domain");

    // ========== MODIFY WRONG ARITY ==========
    ASSERT_ER("(do (set v [1 2]) (modify 'v * 2))", "arity");

    // ========== OUT OF BOUNDS ACCESS ==========
    ASSERT_ER("(do (set v [1 2 3]) (alter 'v set -10 0))", "index");

    // ========== NULL OPERATIONS ==========
    ASSERT_ER("(+ null 1)", "type");
    ASSERT_ER("(sum null)", "type");

    // ========== VALID EDGE CASES (should not crash) ==========
    ASSERT_EQ("(til 0)", "[]");
    ASSERT_EQ("(rand 0 10)", "[]");
    ASSERT_EQ("(at [] 0)", "0Nl");
    ASSERT_EQ("(first [])", "0Nl");
    ASSERT_EQ("(last [])", "0Nl");
    ASSERT_EQ("(/ 1 0)", "0Nl");
    ASSERT_EQ("(group [])", "{}");
    return MUNIT_OK;
}

static MunitResult test_rf_read_csv(const void* params, void* fixture) {
    (void)params; (void)fixture;

    int64_t i;
    FILE *f;

    f = fopen("rf_test_syms.csv", "w");
    munit_assert_ptr_not_null(f);
    fprintf(f, "id,sym\n");
    for (i = 0; i < 20000; i++)
        fprintf(f, "%lld,s%lld\n", (long long)i, (long long)i);
    fclose(f);

    ASSERT_EQ(
        "(count (read-csv [I64 SYMBOL] \"rf_test_syms.csv\"))",
        "20000");

    remove("rf_test_syms.csv");
    return MUNIT_OK;
}

