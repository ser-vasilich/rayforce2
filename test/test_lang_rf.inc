    ASSERT_EQ("(concat [1h] 2h)", "[1h 2h]");
    ASSERT_EQ("(concat 1h [2h])", "[1h 2h]");
    ASSERT_EQ("(concat [1h] [2h])", "[1h 2h]");
    ASSERT_EQ("(concat 1i 2i)", "[1i 2i]");
    ASSERT_EQ("(concat [1i] 2i)", "[1i 2i]");
    ASSERT_EQ("(concat 1i [2i])", "[1i 2i]");
    ASSERT_EQ("(concat [1i] [2i])", "[1i 2i]");
